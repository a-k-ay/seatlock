<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Dev appender: pretty console, human-readable -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] req=%X{requestId:-none} user=%X{userId:-anon} %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Prod appender: JSON, structured, one line per event -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <customFields>{"app":"seatlock"}</customFields>
        </encoder>
    </appender>

    <!-- Default (dev) profile: use pretty console -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Prod profile: use JSON console -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

</configuration>